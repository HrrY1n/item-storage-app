{
  // Cloudflare Workers —— 静态资产（Static Assets）+ 同步 API（Phase 3B）
  //
  // ⚠️ 路由优先级（已显式化，见 assets.run_worker_first）：
  //    /api/*   → **先**进 Worker（任何请求类型，包括地址栏直接访问的 navigation）
  //    其它路径 → 资产路由；未命中静态资源时按 SPA 回落 index.html
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "item-storage-app",
  "compatibility_date": "2026-10-03",

  // Phase 3B：同步 Worker 入口。此前本项目没有 main、没有任何 API。
  "main": "./worker/index.ts",

  "assets": {
    // 构建产物目录，与 vite build 的 outDir 保持一致
    "directory": "./dist",
    // SPA fallback：/search、/items/:id、/categories/:id 等深链一律回落到 index.html
    // 完全由 Cloudflare 资产路由负责；dist 中不放置任何 Pages 专属的重写规则文件
    "not_found_handling": "single-page-application",
    //
    // ⭐ 必须**显式**声明，否则 /api/* 会被 SPA 回落吃掉。
    //    默认行为下 `single-page-application` 的优先级高于 Worker：
    //    在地址栏直接访问 `/api/sync/status`（navigation 请求）会拿到 **index.html**，
    //    只有 `fetch('/api/...')` 这类子资源请求才会进 Worker ——
    //    线上实测正是这个现象，排查时极易误判成"Worker 没部署"。
    //
    // ⚠️ 只用路径数组，不要用 `true`：
    //    `true` 会让**所有**请求（含 .js/.css/.svg 等静态资源）都绕道 Worker，
    //    白白增加 Worker 调用量与首屏延迟。数组形式只放行 /api/*，其余照旧走资产路由。
    "run_worker_first": ["/api/*"]
  },

  // D1 绑定。数据库已由用户在 Cloudflare 面板创建（Create database → item-sync）。
  //
  // ⚠️ 绑定名统一为 SYNC_DB，**不要**改成 Dashboard 示例里那个泛化的 "DB" ——
  //    代码里读的是 env.SYNC_DB（worker/index.ts 的 Env 接口），改名会直接 500。
  //
  // 建表同样不需要命令行认证：在该数据库的 Console 里按顺序执行
  // worker/migrations/*.sql；迁移脚本可重复执行，不能跳过新增约束迁移。
  "d1_databases": [
    {
      "binding": "SYNC_DB",
      "database_name": "item-sync",
      "database_id": "d321784c-7ba0-4750-a468-73228a0bf51f"
    }
  ]
}
