# 依赖
node_modules/

# 构建产物
dist/
*.tsbuildinfo
vite.config.*.timestamp-*

# Cloudflare Workers / Wrangler 本地状态（dev 缓存、上传临时文件）
.wrangler/

# 历史审计基线截图：仅作本地对照，不入库
docs/screenshots/audit-before/

# 测试覆盖率报告
coverage/

# WorkBuddy 本地工作区（含本机路径与开发日志，勿提交）
.workbuddy/

# 本地 Agent 工作记录（不属于产品文档）
task_plan.md
findings.md
progress.md

# 临时产物：浏览器 profile / 临时截图 / 会话缓存
tmp/
temp/
.tmp/
.chrome-profile/
*-profile/
.playwright/
*puppeteer_dev_chrome_profile-*/
.screenshot-tmp/

# 本地文件型 SQLite 运行态（正式同步 schema 仍提交 worker/migrations/*.sql）
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3-journal
*.db
*.db-shm
*.db-wal
*.db-journal

# 环境变量与 Wrangler 本地开发密钥
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example

# 编辑器
.vscode/
.idea/

# 系统文件
.DS_Store
Thumbs.db
[Dd]esktop.ini

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
